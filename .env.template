# ============================================================
#  RIGELSLM - ARQUIVO .env (TEMPLATE)
#  Copie este arquivo para .env e preencha apenas o que precisar.
#  O instalador faz essa copia automaticamente.
# ============================================================

# ------------------------------------------------------------
# 1) API DeepSeek (OPCIONAL - só para gerar dados sintéticos)
#    Crie uma chave (gratuita ou paga) em:
#    https://platform.deepseek.com/
#    Sem chave, o projeto funciona apenas com o Ollama local.
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
MODEL_NAME=deepseek-chat
MAX_COST_USD=5.00
DELAY_SECONDS=2.0

# ------------------------------------------------------------
# 2) Ollama (modelos locais)
# ------------------------------------------------------------
USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------
# 3) Guardião de limites (OPCIONAL)
#    Os limites padrão são PROPORCIONAIS ao hardware da máquina
#    (gerados na instalação em config_recursos.json).
#    Para ajustar manualmente, descomente e altere:
# ------------------------------------------------------------
# MEM_MIN_LIVRE_PCT=12
# SCAN_PAUSA_SEG=0.002
# SCAN_MAX_ARQUIVOS=2000000
# SCAN_MAX_DIRETORIOS=200000
